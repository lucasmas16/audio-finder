<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AudioFinder</RootNamespace>
    <AssemblyName>AudioFinder</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <OutputPath>dist\</OutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AudioFinder.ico</ApplicationIcon>
    <AppConfig>AudioFinder.exe.config</AppConfig>
    <StartupObject>AudioFinder.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Xml" />
    <Compile Include="src\*.cs" />
    <Content Include="assets\devices\*.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <None Include="AudioFinder.exe.config" /><None Include="app.manifest" /><None Include="README.md" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
